#!/bin/sh
# Commit safety gate: refuse a commit that would introduce a credential or a
# personal identifier (specs/002-commit-safety-gate). Activated per clone via
# `git config core.hooksPath .githooks` (README.md Setup step; scripts/check_env.py's
# git_hooks row reports whether this clone has it). Runs the system python3, not
# the project's .venv: git hooks do not activate a virtualenv.
set -u

repo_root="$(git rev-parse --show-toplevel)" || exit 1
cd "$repo_root" || exit 1

python3 scripts/scan_secrets.py --staged
exit $?
