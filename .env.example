# Copy to `.env`. Non-secret configuration ONLY. Secrets live in the secrets backend (a
# local age-encrypted vault by default; the macOS Keychain or GCP Secret Manager when
# configured), never here.

# Persistent Chrome profile used by Headless (outside the repo; seeded by logging in by hand).
HEADLESS_PROFILE_DIR=~/.headless/chrome-profile

# 1 = a real windowed Chrome can be produced (default; required for --apply, whose handoff
# needs a window). 0 = no windowed Chrome ever on this machine; --apply is refused.
HEADLESS_HEADED=1

# Quiet by default: 0 = invisible unless the run needs a window (default). 1 = visible from
# launch for preview/check, and skips apply's quiet-until-handoff window hiding. Same as
# passing --show.
HEADLESS_SHOW=0

# Optional: attach to an already-running Chrome started with --remote-debugging-port instead
# of launching one. Leave empty to launch. Attach only to a Chrome started for Headless: the
# attached context carries every session that browser holds.
HEADLESS_CDP_URL=

# Secrets backend: age (default, local passphrase-encrypted vault), keychain (macOS only), or
# gcp.
HEADLESS_SECRETS_BACKEND=age
# Keychain account name used for every Headless item (keychain backend only).
HEADLESS_KEYCHAIN_ACCOUNT=headless
# Required when HEADLESS_SECRETS_BACKEND=gcp.
HEADLESS_GCP_PROJECT=

# Path to the age-encrypted vault file (age backend only). Must be absolute or ~-relative; a
# bare relative value is refused. Default: ~/.headless/profile.age
HEADLESS_AGE_FILE=~/.headless/profile.age

# Where preview artifacts are written.
HEADLESS_PREVIEW_DIR=previews
