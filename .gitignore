# Secrets and personal data - never commit
.env
*.token
profile.local.json
service_account*.json
*.age*

# Terraform (spec 010-google-maps-connector): provider cache, state, and variable files
# stay local; the dependency lock file is committed.
terraform/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json

# Runtime artifacts
previews/
reports/
chrome-profile/
*.har
session-cookies.json*

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Claude Code local permissions
.claude/settings.local.json
